@startuml
title BlaiseConnect - Schéma relationnel global cible (migrations 001 à 006)
top to bottom direction
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam ArrowColor #546E7A

package "Accès et profils" #FFEBEE {
  entity accounts #FFCDD2 {
    * id : uuid <<PK>>
    * registration_number : varchar(50) <<UQ>>
    * role : varchar(20)
    * is_active : boolean
    archived_at : timestamptz
  }
  entity auth_sessions #FFCDD2 {
    * id : uuid <<PK>>
    * account_id : uuid <<FK>>
    * session_token_hash : text <<UQ>>
  }
  entity students #BBDEFB {
    * id : uuid <<PK>>
    * account_id : uuid <<FK, UQ>>
    * first_name : varchar(100)
    * last_name : varchar(100)
    * status : student_status_enum
  }
  entity teachers #C8E6C9 {
    * id : uuid <<PK>>
    * account_id : uuid <<FK, UQ>>
    * first_name : varchar(100)
    * last_name : varchar(100)
  }
  entity administrators #FFE0B2 {
    * id : uuid <<PK>>
    * account_id : uuid <<FK, UQ>>
    * first_name : varchar(100)
    * last_name : varchar(100)
  }
  entity guardians #E1BEE7 {
    * id : uuid <<PK>>
    account_id : uuid <<FK, UQ>>
    * first_name : varchar(100)
    * last_name : varchar(100)
  }
  entity student_status_history #FFE0B2 {
    * id : uuid <<PK>>
    * student_id : uuid <<FK>>
    * old_status : student_status_enum
    * new_status : student_status_enum
  }
  entity student_guardians #FFF9C4 {
    * student_id : uuid <<PK, FK>>
    * guardian_id : uuid <<PK, FK>>
    * relationship_type : varchar(10)
    * is_primary_contact : boolean
  }
}

package "Documents" #EDE7F6 {
  entity document_types #D1C4E9 {
    * id : uuid <<PK>>
    * code : varchar(50) <<UQ>>
    * label : varchar(100)
    * is_active : boolean
  }
  entity documents #D1C4E9 {
    * id : uuid <<PK>>
    * document_type_id : uuid <<FK>>
    * storage_path : varchar(500) <<UQ>>
    * original_filename : varchar(255)
    * sha256 : char(64)
    * uploaded_by_account_id : uuid <<FK>>
  }
}

package "Structure scolaire" #ECEFF1 {
  entity school_years #E0E0E0 {
    * id : uuid <<PK>>
    * name : varchar(20) <<UQ>>
    * start_date : date
    * end_date : date
    * is_current : boolean
    closed_at : timestamptz
  }
  entity reporting_periods #E0E0E0 {
    * id : uuid <<PK>>
    * school_year_id : uuid <<FK>>
    * name : varchar(100)
    * start_date : date
    * end_date : date
  }
  entity class_levels #E0E0E0 {
    * id : uuid <<PK>>
    * code : class_level_code_enum <<UQ>>
    * education_stage : education_stage_enum
  }
  entity classes #BBDEFB {
    * id : uuid <<PK>>
    * school_year_id : uuid <<FK>>
    * class_level_id : uuid <<FK>>
    * main_teacher_id : uuid <<FK>>
    * group_label : varchar(30)
  }
  entity student_enrollments #FFF9C4 {
    * id : uuid <<PK>>
    * student_id : uuid <<FK>>
    * class_id : uuid <<FK>>
    * start_date : date
    end_date : date
  }
  entity subjects #C8E6C9 {
    * id : uuid <<PK>>
    * name : varchar(100) <<UQ>>
    * is_active : boolean
  }
  entity class_subjects #C8E6C9 {
    * id : uuid <<PK>>
    * class_id : uuid <<FK>>
    * subject_id : uuid <<FK>>
    * coefficient : numeric(6,2)
  }
  entity teacher_assignments #C8E6C9 {
    * id : uuid <<PK>>
    * teacher_id : uuid <<FK>>
    * class_subject_id : uuid <<FK>>
    * start_date : date
    end_date : date
  }
}

package "Évaluations et notes" #E3F2FD {
  entity assessments #BBDEFB {
    * id : uuid <<PK>>
    * teacher_assignment_id : uuid <<FK>>
    * title : varchar(150)
    * assessment_date : date
    * maximum_score : numeric(6,2)
    * coefficient : numeric(6,2)
  }
  entity grades #BBDEFB {
    * id : uuid <<PK>>
    * assessment_id : uuid <<FK>>
    * student_enrollment_id : uuid <<FK>>
    * result_type : varchar(10)
    score : numeric(6,2)
    justification_status : varchar(20)
  }
  entity grade_change_requests #FFE0B2 {
    * id : uuid <<PK>>
    * grade_id : uuid <<FK>>
    * requested_by_account_id : uuid <<FK>>
    * proposed_result_type : varchar(10)
    proposed_score : numeric(6,2)
    * status : varchar(20)
  }
  entity grade_documents #D1C4E9 {
    * grade_id : uuid <<PK, FK>>
    * document_id : uuid <<PK, FK>>
  }
}

package "Appels et assiduité" #FFFDE7 {
  entity attendance_events #FFF9C4 {
    * id : uuid <<PK>>
    * teacher_assignment_id : uuid <<FK>>
    * attendance_date : date
    * course_start_time : time
    * course_end_time : time
  }
  entity attendance_records #FFF9C4 {
    * id : uuid <<PK>>
    * attendance_event_id : uuid <<FK>>
    * student_enrollment_id : uuid <<FK>>
    * incident_type : varchar(10)
    late_minutes : smallint
    * justification_status : varchar(20)
    deleted_at : timestamptz
  }
  entity attendance_record_history #FFE0B2 {
    * id : uuid <<PK>>
    * attendance_record_id : uuid <<FK>>
    * changed_by_account_id : uuid <<FK>>
    * changed_at : timestamptz
  }
  entity attendance_change_requests #FFE0B2 {
    * id : uuid <<PK>>
    * attendance_record_id : uuid <<FK>>
    * requested_by_account_id : uuid <<FK>>
    * requested_action : varchar(10)
    * status : varchar(20)
  }
  entity attendance_record_documents #D1C4E9 {
    * attendance_record_id : uuid <<PK, FK>>
    * document_id : uuid <<PK, FK>>
  }
}

package "Bulletins" #F3E5F5 {
  entity report_cards #E1BEE7 {
    * id : uuid <<PK>>
    * student_enrollment_id : uuid <<FK>>
    * reporting_period_id : uuid <<FK>>
    * general_average : numeric(6,2)
    * generated_by_account_id : uuid <<FK>>
    validated_by_account_id : uuid <<FK>>
    validated_at : timestamptz
    pdf_document_id : uuid <<FK>>
  }
  entity report_card_subjects #E1BEE7 {
    * report_card_id : uuid <<PK, FK>>
    * class_subject_id : uuid <<PK, FK>>
    * subject_average : numeric(6,2)
    * applied_coefficient : numeric(6,2)
  }
  entity report_card_grades #E1BEE7 {
    * report_card_id : uuid <<PK, FK>>
    * grade_id : uuid <<PK, FK>>
  }
  entity school_year_deletion_audits #CFD8DC {
    * id : uuid <<PK>>
    * school_year_id : uuid
    * school_year_name : varchar(20)
    * deleted_by_account_id : uuid
    * deleted_counts : jsonb
  }
}

package "Emploi du temps" #E0F2F1 {
  entity school_day_schedules #B2DFDB {
    * id : uuid <<PK>>
    * school_year_id : uuid <<FK>>
    * education_stage : education_stage_enum
    * day_of_week : smallint
  }
  entity break_schedules #B2DFDB {
    * id : uuid <<PK>>
    * school_day_schedule_id : uuid <<FK>>
    * start_time : time
    * end_time : time
  }
  entity level_subject_requirements #B2DFDB {
    * school_year_id : uuid <<FK>>
    * class_level_id : uuid <<FK>>
    * subject_id : uuid <<FK>>
    * weekly_minutes : smallint
  }
  entity timetables #B2DFDB {
    * id : uuid <<PK>>
    * class_id : uuid <<FK>>
    * version : smallint
    * status : timetable_status_enum
  }
  entity timetable_slots #B2DFDB {
    * id : uuid <<PK>>
    * timetable_id : uuid <<FK>>
    * teacher_assignment_id : uuid <<FK>>
    room_id : uuid <<FK>>
  }
  entity special_courses #B2DFDB {
    * id : uuid <<PK>>
    * student_enrollment_id : uuid <<FK>>
    * subject_id : uuid <<FK>>
  }
}

accounts ||--o{ auth_sessions
accounts ||--o| students
accounts ||--o| teachers
accounts ||--o| administrators
accounts |o--o| guardians
students ||--o{ student_status_history
students ||--o{ student_guardians
guardians ||--o{ student_guardians

document_types ||--o{ documents
accounts ||--o{ documents : uploads

school_years ||--o{ reporting_periods
school_years ||--o{ classes
class_levels ||--o{ classes
teachers ||--o{ classes : main teacher
students ||--o{ student_enrollments
classes ||--o{ student_enrollments
classes ||--o{ class_subjects
subjects ||--o{ class_subjects
teachers ||--o{ teacher_assignments
class_subjects ||--o{ teacher_assignments

teacher_assignments ||--o{ assessments
assessments ||--o{ grades
student_enrollments ||--o{ grades
grades ||--o{ grade_change_requests
grades ||--o{ grade_documents
documents ||--o{ grade_documents

teacher_assignments ||--o{ attendance_events
attendance_events ||--o{ attendance_records
student_enrollments ||--o{ attendance_records
attendance_records ||--o{ attendance_record_history
attendance_records ||--o{ attendance_change_requests
attendance_records ||--o{ attendance_record_documents
documents ||--o{ attendance_record_documents

student_enrollments ||--o{ report_cards
reporting_periods ||--o{ report_cards
report_cards ||--o{ report_card_subjects
class_subjects ||--o{ report_card_subjects
report_cards ||--o{ report_card_grades
grades ||--o{ report_card_grades
documents |o--o| report_cards : PDF

school_years ||--o{ school_day_schedules
school_day_schedules ||--o{ break_schedules
school_years ||--o{ level_subject_requirements
class_levels ||--o{ level_subject_requirements
subjects ||--o{ level_subject_requirements
classes ||--o{ timetables
timetables ||--o{ timetable_slots
teacher_assignments ||--o{ timetable_slots
student_enrollments ||--o{ special_courses
subjects ||--o{ special_courses

note bottom of grades
Absence justifiée : exclue du calcul.
Absence non justifiée ou rejetée : valeur effective zéro.
La valeur numérique reste NULL pour distinguer l'absence d'un vrai 0.
end note

note bottom of attendance_events
Une ligne prouve que l'appel a été effectué.
Sans attendance_record, l'élève est considéré présent.
end note
@enduml
