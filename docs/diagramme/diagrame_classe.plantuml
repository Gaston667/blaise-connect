@startuml
title BlaiseConnect - Architecture MVC globale

left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

legend left
|= Couleur |= Couche |
|<#E8F5E9>| Vue React |
|<#FFF3E0>| Contrôleur et services FastAPI |
|<#FFEBEE>| Contrats Pydantic |
|<#E3F2FD>| Modèles SQLAlchemy |
|<#ECEFF1>| Utilitaires |
endlegend

package "VUE - React" #E8F5E9 {
  class "App.jsx" as App
  class "pages/login_page.jsx" as LoginPage
  class "pages/home_page.jsx" as HomePage
  class "pages/accounts_page.jsx" as AccountsPage
  class "pages/school_years_page.jsx" as SchoolYearsPage
  class "pages/school_year_details_page.jsx" as SchoolYearDetailsPage
  class "pages/school_classes_page.jsx" as SchoolClassesPage <<préparé US-004>>
  class "pages/subjects_page.jsx" as SubjectsPage <<préparé US-005>>
  class "pages/teachers_page.jsx" as TeachersPage <<préparé US-006>>

  class "services/auth_service.js" as FrontAuthService
  class "services/account_service.js" as FrontAccountService
  class "services/school_year_service.js" as FrontSchoolYearService
  class "services/school_class_service.js" as FrontSchoolClassService <<préparé>>
  class "services/subject_service.js" as FrontSubjectService <<préparé>>
  class "services/teacher_service.js" as FrontTeacherService <<préparé>>
}

package "CONTROLEUR - FastAPI" #FFF3E0 {
  class "routes/auth.py" as AuthRoutes
  class "routes/accounts.py" as AccountRoutes
  class "routes/school_years.py" as SchoolYearRoutes
  class "routes/reporting_periods.py" as ReportingPeriodRoutes
  class "routes/school_classes.py" as SchoolClassRoutes <<non activé>>
  class "routes/subjects.py" as SubjectRoutes <<non activé>>
  class "routes/teachers.py" as TeacherRoutes <<non activé>>

  class "services/auth_service.py" as AuthService
  class "services/session_service.py" as SessionService
  class "services/account_service.py" as AccountService
  class "services/school_year_service.py" as SchoolYearService
  class "services/reporting_period_service.py" as ReportingPeriodService
  class "services/school_class_service.py" as SchoolClassService <<à implémenter>>
  class "services/subject_service.py" as SubjectService <<à implémenter>>
  class "services/teacher_service.py" as TeacherService <<à implémenter>>
}

package "CONTRATS - Pydantic" #FFEBEE {
  class LoginRequest
  class LoginResponse
  class AccountCreate
  class AccountUpdate
  class AccountResponse
  class SchoolYearCreate
  class SchoolYearUpdate
  class SchoolYearDetailsUpdate
  class SchoolYearPeriodUpdate
  class SchoolYearResponse
  class SchoolYearDetailsResponse
  class SchoolYearDeletionConfirmation
  class SchoolYearDeletionPreview
  class SchoolYearDeletionResponse
  class ReportingPeriodCreate
  class ReportingPeriodUpdate
  class ReportingPeriodResponse
  class SchoolClassCreate <<préparé>>
  class SchoolClassUpdate <<préparé>>
  class SchoolClassResponse <<préparé>>
  class SubjectCreate <<préparé>>
  class SubjectUpdate <<préparé>>
  class SubjectResponse <<préparé>>
  class ClassSubjectCreate <<préparé>>
  class ClassSubjectResponse <<préparé>>
  class TeacherCreate <<préparé>>
  class TeacherUpdate <<préparé>>
  class TeacherResponse <<préparé>>
}

package "MODELE - SQLAlchemy" #E3F2FD {
  class Account
  class AuthSession
  class SchoolYear
  class SchoolPeriod
  class SchoolClass <<préparé>>
  class Subject <<préparé>>
  class ClassSubject <<préparé>>
  class Teacher <<préparé>>
}

package "UTILITAIRES - Core" #ECEFF1 {
  class Authentication
  class Security
  class Database
  class AccountLockedError
  class AccountAlreadyExistsError
  class SchoolYearNotFoundError
  class SchoolYearAlreadyClosedError
  class SchoolYearPeriodsMismatchError
  class ReportingPeriodNotFoundError
  class SchoolYearConfirmationMismatchError
}

App --> LoginPage
App --> HomePage
App --> AccountsPage
App --> SchoolYearsPage
App --> SchoolYearDetailsPage
App ..> SchoolClassesPage : futur
App ..> SubjectsPage : futur
App ..> TeachersPage : futur

LoginPage --> FrontAuthService
AccountsPage --> FrontAccountService
SchoolYearsPage ..> FrontSchoolYearService
SchoolYearDetailsPage --> FrontSchoolYearService
SchoolClassesPage ..> FrontSchoolClassService
SubjectsPage ..> FrontSubjectService
TeachersPage ..> FrontTeacherService

FrontAuthService ..> AuthRoutes : HTTP
FrontAccountService ..> AccountRoutes : HTTP
FrontSchoolYearService ..> SchoolYearRoutes : HTTP
FrontSchoolYearService ..> ReportingPeriodRoutes : HTTP
FrontSchoolClassService ..> SchoolClassRoutes : HTTP futur
FrontSubjectService ..> SubjectRoutes : HTTP futur
FrontTeacherService ..> TeacherRoutes : HTTP futur

AuthRoutes --> AuthService
AuthRoutes --> SessionService
AccountRoutes --> AccountService
SchoolYearRoutes ..> SchoolYearService
ReportingPeriodRoutes --> ReportingPeriodService
SchoolClassRoutes ..> SchoolClassService
SubjectRoutes ..> SubjectService
TeacherRoutes ..> TeacherService

AccountService --> Account
SessionService --> AuthSession
SchoolYearService ..> SchoolYear
SchoolYearService ..> SchoolPeriod
ReportingPeriodService --> SchoolPeriod
ReportingPeriodService --> SchoolYearService
SchoolClassService ..> SchoolClass
SubjectService ..> Subject
SubjectService ..> ClassSubject
TeacherService ..> Teacher

SchoolYear "1" -- "0..*" SchoolPeriod
SchoolYear "1" -- "0..*" SchoolClass
SchoolClass "1" -- "0..*" ClassSubject
Subject "1" -- "0..*" ClassSubject
Account "1" -- "0..1" Teacher

Authentication --> SessionService
Authentication --> Account
AuthService --> Security
Database ..> Account

note bottom of SchoolPeriod
L'administrateur choisit la date de fin.
Le début est calculé automatiquement.
Une année active peut encore ne contenir aucune période.
Décisions D-004 et D-005 validées.
end note

note bottom of ClassSubject
Coefficient positif configuré par l'administrateur.
Décision D-016 validée ; arrondi encore à confirmer.
end note

@enduml
