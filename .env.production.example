# Copier vers .env sur le serveur de production, puis remplacer les valeurs.
APP_ENV=production
DOMAIN=blaiseconnect.example.org
CADDY_EMAIL=admin@blaiseconnect.example.org
ALLOWED_HOSTS=blaiseconnect.example.org
ALLOWED_ORIGINS=https://blaiseconnect.example.org
SESSION_COOKIE_SECURE=true

# Ne jamais reutiliser ces exemples comme secrets reels.
POSTGRES_DB=blaise_connect
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_APP_USER=blaise_app
POSTGRES_APP_PASSWORD=change-me
